<Application
    x:Class="NetworkSpeedLogger.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary>
          <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
              <SolidColorBrush x:Key="AppPaneBrush" Color="#70F3F3F3" />
              <SolidColorBrush x:Key="AppContentBrush" Color="#30F9F9F9" />
              <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B0FFFFFF" />
              <SolidColorBrush x:Key="CardBorderBrush" Color="#18000000" />
              <SolidColorBrush x:Key="SubtleTextBrush" Color="#9E000000" />
              <SolidColorBrush x:Key="ChartGridBrush" Color="#12000000" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
              <SolidColorBrush x:Key="AppPaneBrush" Color="#70202020" />
              <SolidColorBrush x:Key="AppContentBrush" Color="#40272727" />
              <SolidColorBrush x:Key="CardBackgroundBrush" Color="#A52D2D2D" />
              <SolidColorBrush x:Key="CardBorderBrush" Color="#22FFFFFF" />
              <SolidColorBrush x:Key="SubtleTextBrush" Color="#9EFFFFFF" />
              <SolidColorBrush x:Key="ChartGridBrush" Color="#16FFFFFF" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
              <SolidColorBrush x:Key="AppPaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
              <SolidColorBrush x:Key="AppContentBrush" Color="{ThemeResource SystemColorWindowColor}" />
              <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
              <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
              <SolidColorBrush x:Key="SubtleTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
              <SolidColorBrush x:Key="ChartGridBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            </ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="DownloadBrush" Color="#0F6CBD" />
      <SolidColorBrush x:Key="UploadBrush" Color="#0F7B6C" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B6C" />

      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
      </Style>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
