<Window
    x:Class="NetworkSpeedLogger.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetworkSpeedLogger">

  <Grid x:Name="RootGrid" Background="{ThemeResource AppContentBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="SettingsTitleBar" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Width="22" Height="22" Margin="18,0,10,0" Source="Icon.png" IsHitTestVisible="False"
             Stretch="Uniform" VerticalAlignment="Center" />
      <TextBlock x:Name="TitleBarText" Grid.Column="1" Text="设置" VerticalAlignment="Center"
                 FontSize="12" FontWeight="SemiBold" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Padding="24,14,24,10" Spacing="2">
          <TextBlock x:Name="PageTitleText" Text="设置" FontSize="24" FontWeight="SemiBold" />
          <TextBlock x:Name="PageSubtitleText" Text="管理每次启动时使用的默认值和文件保存位置"
                     Style="{StaticResource CaptionStyle}" />
        </StackPanel>
      <TabView x:Name="SettingsTabView" Grid.Row="1" Margin="18,0,18,0"
               IsAddTabButtonVisible="False" CanReorderTabs="False" TabWidthMode="Equal">
        <TabViewItem IsClosable="False">
          <TabViewItem.Header>
            <TextBlock x:Name="GeneralTabText" Text="通用" />
          </TabViewItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="6,12,6,18" Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock x:Name="GeneralSectionText" Text="常规" Style="{StaticResource SectionTitleStyle}" />
          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="LanguageLabel" Text="界面语言" FontWeight="SemiBold" />
                <TextBlock x:Name="LanguageDescription" Text="默认根据 Windows 显示语言自动选择"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <ComboBox x:Name="LanguageCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Name="LanguageAutoItem" Tag="Auto" Content="跟随系统" />
                <ComboBoxItem x:Name="LanguageChineseItem" Tag="zh-CN" Content="简体中文" />
                <ComboBoxItem x:Name="LanguageEnglishItem" Tag="en-US" Content="English" />
              </ComboBox>
            </Grid>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="ThemeLabel" Text="应用外观" FontWeight="SemiBold" />
                <TextBlock x:Name="ThemeDescription" Text="默认跟随 Windows 浅色或深色模式"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <ComboBox x:Name="ThemeCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                        SelectionChanged="ThemeCombo_SelectionChanged">
                <ComboBoxItem x:Name="ThemeAutoItem" Tag="Auto" Content="跟随系统" />
                <ComboBoxItem x:Name="ThemeLightItem" Tag="Light" Content="浅色" />
                <ComboBoxItem x:Name="ThemeDarkItem" Tag="Dark" Content="深色" />
              </ComboBox>
            </Grid>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="MinimizeToTrayLabel" Text="最小化到托盘" FontWeight="SemiBold" />
                <TextBlock x:Name="MinimizeToTrayDescription" Text="开启后，点击关闭按钮会让应用继续在后台运行"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1"
                            MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabViewItem>

        <TabViewItem IsClosable="False">
          <TabViewItem.Header>
            <TextBlock x:Name="RecordingTabText" Text="记录" />
          </TabViewItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="6,12,6,18" Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock x:Name="DefaultsSectionText" Text="启动默认值" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock x:Name="DefaultsDescriptionText" Text="主窗口中的临时修改不会覆盖这些值"
                     Style="{StaticResource CaptionStyle}" />

          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="DefaultDurationLabel" Text="运行时长" FontWeight="SemiBold" />
                <TextBlock x:Name="DefaultDurationDescription" Text="小时；0 表示不限时"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <NumberBox x:Name="DefaultDurationNumber" Grid.Column="1" Minimum="0" Maximum="8760"
                         SmallChange="1" SpinButtonPlacementMode="Inline" />
            </Grid>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="DefaultIntervalLabel" Text="采样间隔" FontWeight="SemiBold" />
                <TextBlock x:Name="DefaultIntervalDescription" Text="1 到 3600 秒"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <NumberBox x:Name="DefaultIntervalNumber" Grid.Column="1" Minimum="1" Maximum="3600"
                         SmallChange="1" SpinButtonPlacementMode="Inline" />
            </Grid>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="DefaultUnitLabel" Text="速度单位" FontWeight="SemiBold" />
                <TextBlock x:Name="DefaultUnitDescription" Text="只影响显示和输出列单位"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <ComboBox x:Name="DefaultUnitCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Name="DefaultUnitMbItem" Tag="MB/s" Content="MB/s（兆字节/秒）" />
                <ComboBoxItem x:Name="DefaultUnitMbpsItem" Tag="Mbps" Content="Mbps（兆比特/秒）" />
              </ComboBox>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock x:Name="FilesSectionText" Text="文件" Style="{StaticResource SectionTitleStyle}" />
          <Border Style="{StaticResource CardStyle}" Padding="14,10">
            <StackPanel Spacing="7">
              <StackPanel Spacing="3">
                <TextBlock x:Name="OutputFolderLabel" Text="结果保存位置" FontWeight="SemiBold" />
                <TextBlock x:Name="OutputFolderDescription" Text="CSV 和 Markdown 汇总都会保存到此文件夹"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <TextBox x:Name="OutputFolderText" IsReadOnly="True" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                    <TextBlock x:Name="OpenFolderButtonText" Text="打开" />
                  </StackPanel>
                </Button>
                <Button x:Name="BrowseButton" Click="BrowseButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xED43;" FontSize="13" />
                    <TextBlock x:Name="BrowseButtonText" Text="更改" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabViewItem>

        <TabViewItem IsClosable="False">
          <TabViewItem.Header>
            <TextBlock x:Name="TaskbarTabText" Text="任务栏" />
          </TabViewItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="6,12,6,18" Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock x:Name="TaskbarSectionText" Text="任务栏网速" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock x:Name="TaskbarSectionDescription" Text="在主任务栏上持续显示独立采样的实时下载和上传速度"
                     Style="{StaticResource CaptionStyle}" />

          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="TaskbarEnabledLabel" Text="显示任务栏网速" FontWeight="SemiBold" />
                <TextBlock x:Name="TaskbarEnabledDescription" Text="应用运行期间显示；内容不会响应点击"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <ToggleSwitch x:Name="TaskbarEnabledToggle" Grid.Column="1"
                            MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Toggled="TaskbarEnabledToggle_Toggled" />
            </Grid>
          </Border>

          <StackPanel x:Name="TaskbarOptionsPanel" Spacing="6">
            <Border Style="{StaticResource CardStyle}" Padding="14,9">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                  <TextBlock x:Name="TaskbarLayoutLabel" Text="显示布局" FontWeight="SemiBold" />
                  <TextBlock x:Name="TaskbarLayoutDescription"
                             Text="选择上传和下载的排列方式"
                             Style="{StaticResource CaptionStyle}" />
                </StackPanel>
                <ComboBox x:Name="TaskbarLayoutCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                  <ComboBoxItem x:Name="TaskbarLayoutTwoLineItem" Tag="TwoLine" Content="双行" />
                  <ComboBoxItem x:Name="TaskbarLayoutSingleLineItem" Tag="SingleLine" Content="单行" />
                </ComboBox>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="14,9">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                  <TextBlock x:Name="TaskbarIntervalLabel" Text="采样频率" FontWeight="SemiBold" />
                  <TextBlock x:Name="TaskbarIntervalDescription" Text="1 到 3600 秒；默认为 1 秒"
                             Style="{StaticResource CaptionStyle}" />
                </StackPanel>
                <NumberBox x:Name="TaskbarIntervalNumber" Grid.Column="1" Minimum="1" Maximum="3600"
                           SmallChange="1" SpinButtonPlacementMode="Inline" />
              </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="14,9">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                  <TextBlock x:Name="TaskbarUnitLabel" Text="速度单位" FontWeight="SemiBold" />
                  <TextBlock x:Name="TaskbarUnitDescription" Text="K、M、G 等前缀会根据实时速度自动变化"
                             Style="{StaticResource CaptionStyle}" />
                </StackPanel>
                <ComboBox x:Name="TaskbarUnitCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                  <ComboBoxItem x:Name="TaskbarUnitByteItem" Tag="Byte" Content="Byte（B/s、KB/s、MB/s）" />
                  <ComboBoxItem x:Name="TaskbarUnitBitItem" Tag="bit" Content="bit（bps、Kbps、Mbps）" />
                </ComboBox>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="14,9">
              <StackPanel Spacing="7">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="TaskbarAdapterModeLabel" Text="网卡模式" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaskbarAdapterModeDescription" Text="与网速记录功能分开设置"
                               Style="{StaticResource CaptionStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <RadioButton x:Name="TaskbarAutoModeRadio" GroupName="TaskbarAdapterMode" IsChecked="True"
                                 Content="自动（推荐）" Checked="TaskbarAdapterMode_Changed" />
                    <RadioButton x:Name="TaskbarManualModeRadio" GroupName="TaskbarAdapterMode"
                                 Content="手动" Checked="TaskbarAdapterMode_Changed" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="TaskbarAdapterModeHint" Style="{StaticResource CaptionStyle}" />
                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="4">
                  <ListView x:Name="TaskbarAdapterList" Height="132" SelectionMode="None"
                            ItemsSource="{x:Bind TaskbarAdapterChoices}">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="3" />
                      </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="local:AdapterChoice">
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch">
                          <StackPanel Margin="4,1,0,1" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionStyle}"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </Border>
                <Button x:Name="TaskbarRefreshAdaptersButton" HorizontalAlignment="Right"
                        Click="TaskbarRefreshAdaptersButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    <TextBlock x:Name="TaskbarRefreshAdaptersText" Text="刷新网卡列表" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabViewItem>

        <TabViewItem IsClosable="False">
          <TabViewItem.Header>
            <TextBlock x:Name="UpdatesTabText" Text="更新" />
          </TabViewItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="6,12,6,18" Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock x:Name="UpdatesSectionText" Text="更新" Style="{StaticResource SectionTitleStyle}" />
          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="AutomaticUpdatesLabel" Text="自动检查更新" FontWeight="SemiBold" />
                <TextBlock x:Name="AutomaticUpdatesDescription" Text="应用启动后每天最多检查一次正式版"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <ToggleSwitch x:Name="AutomaticUpdatesToggle" Grid.Column="1" IsOn="True"
                            MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="CurrentVersionLabel" Text="当前版本" FontWeight="SemiBold" />
                <TextBlock x:Name="UpdateStatusText" Text="—"
                           Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="UpdateProgressRing" Width="18" Height="18"
                              IsActive="False" Visibility="Collapsed" />
                <Button x:Name="CheckUpdateButton" Click="CheckUpdateButton_Click">
                  <TextBlock x:Name="CheckUpdateButtonText" Text="检查更新" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <InfoBar x:Name="UpdateResultInfoBar" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
              <Button x:Name="ViewUpdateButton" Click="OpenUpdateReleaseButton_Click"
                      Visibility="Collapsed">
                <TextBlock x:Name="ViewUpdateButtonText" Text="查看更新" />
              </Button>
            </InfoBar.ActionButton>
          </InfoBar>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock x:Name="AboutSectionText" Text="关于" Style="{StaticResource SectionTitleStyle}" />
          <Border Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="Network Speed Logger" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Text="—" Style="{StaticResource CaptionStyle}" />
              </StackPanel>
              <Button x:Name="RepositoryButton" Grid.Column="1" Click="RepositoryButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                  <TextBlock x:Name="RepositoryButtonText" Text="GitHub 仓库" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabViewItem>
      </TabView>
    </Grid>

    <InfoBar x:Name="ValidationInfoBar" Grid.Row="2" Margin="16,0,16,0"
             IsOpen="False" IsClosable="True" Severity="Error" />

    <Border Grid.Row="3" Background="Transparent" Padding="16,10">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SaveHintText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"
                   Text="保存后立即应用可用设置" />
        <Button x:Name="CancelButton" Grid.Column="1" Content="取消" TabIndex="0" Click="CancelButton_Click" />
        <Button x:Name="SaveButton" Grid.Column="2" Content="保存"
                Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
      </Grid>
    </Border>

  </Grid>
</Window>
