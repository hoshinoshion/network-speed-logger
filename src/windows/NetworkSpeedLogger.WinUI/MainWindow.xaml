<Window
    x:Class="NetworkSpeedLogger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NetworkSpeedLogger"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <Grid x:Name="RootGrid" Background="{ThemeResource AppContentBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Width="28" Height="28" Margin="16,0,10,0" Source="Icon.png" IsHitTestVisible="False"
             Stretch="Uniform" VerticalAlignment="Center" />
      <TextBlock x:Name="TitleBarText" Grid.Column="1" VerticalAlignment="Center"
                 FontSize="12" FontWeight="SemiBold" Text="Network Speed Logger" />
    </Grid>

    <Grid x:Name="MainContentGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="Transparent">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        IsTabStop="False" AllowFocusOnInteraction="False">
            <StackPanel x:Name="ConfigurationPanel" Padding="18,14,18,10" Spacing="10">
              <StackPanel Spacing="2">
                <TextBlock x:Name="CurrentSessionTitle" Text="本次记录" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentSessionDescription" Style="{StaticResource CaptionStyle}"
                           Text="主窗口中的修改只在本次启动期间有效" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock x:Name="DurationLabel" Text="运行时长（小时）" />
                <NumberBox x:Name="DurationNumber" Minimum="0" Maximum="8760" SmallChange="1" IsTabStop="False"
                           SpinButtonPlacementMode="Inline" ToolTipService.ToolTip="输入 0 表示不限时" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock x:Name="IntervalLabel" Text="采样间隔（秒）" />
                <NumberBox x:Name="IntervalNumber" Minimum="1" Maximum="3600" SmallChange="1" IsTabStop="False"
                           SpinButtonPlacementMode="Inline" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock x:Name="UnitLabel" Text="速度单位" />
                <ComboBox x:Name="UnitCombo" HorizontalAlignment="Stretch" SelectionChanged="UnitCombo_SelectionChanged">
                  <ComboBoxItem x:Name="UnitMbItem" Tag="MB/s" Content="MB/s（兆字节/秒）" />
                  <ComboBoxItem x:Name="UnitMbpsItem" Tag="Mbps" Content="Mbps（兆比特/秒）" />
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="5">
                <TextBlock x:Name="AdapterModeLabel" Text="网卡模式" />
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <RadioButton x:Name="AutoModeRadio" GroupName="AdapterMode" IsChecked="True"
                               Content="自动（推荐）" Checked="AdapterMode_Changed" />
                  <RadioButton x:Name="ManualModeRadio" GroupName="AdapterMode"
                               Content="手动" Checked="AdapterMode_Changed" />
                </StackPanel>
                <TextBlock x:Name="AdapterModeHint" Style="{StaticResource CaptionStyle}" />
                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="4">
                  <ListView x:Name="AdapterList" Height="126" SelectionMode="None"
                            ItemsSource="{x:Bind AdapterChoices}">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="3" />
                      </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="local:AdapterChoice">
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch">
                          <StackPanel Margin="4,1,0,1" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionStyle}"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </Border>
                <Button x:Name="RefreshAdaptersButton" HorizontalAlignment="Stretch"
                        Click="RefreshAdaptersButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    <TextBlock x:Name="RefreshAdaptersText" Text="刷新网卡列表" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <StackPanel Spacing="5">
                <TextBlock x:Name="OutputFolderLabel" Text="结果保存位置" />
                <TextBox x:Name="OutputFolderText" IsReadOnly="True" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BrowseButton" HorizontalAlignment="Stretch" Click="BrowseButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xED43;" FontSize="13" />
                      <TextBlock x:Name="BrowseButtonText" Text="更改" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="OpenFolderButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OpenFolderButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                      <TextBlock x:Name="OpenFolderButtonText" Text="打开" />
                    </StackPanel>
                  </Button>
                </Grid>
                <InfoBar x:Name="FolderInfoBar" IsOpen="False" IsClosable="False" Severity="Warning">
                  <InfoBar.ActionButton>
                    <Button x:Name="ChooseFolderButton" Content="选择文件夹" Click="BrowseButton_Click" />
                  </InfoBar.ActionButton>
                </InfoBar>
              </StackPanel>

              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Click="StartButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                    <TextBlock x:Name="StartButtonText" Text="开始记录" />
                  </StackPanel>
                </Button>
                <Button x:Name="StopButton" Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False"
                        Click="StopButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="12" />
                    <TextBlock x:Name="StopButtonText" Text="结束记录" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="1" Padding="18,8">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="SettingsButton" Grid.Column="0" Width="32" Height="28" Padding="0" TabIndex="0"
                      VerticalAlignment="Center" ToolTipService.ToolTip="Settings" Click="SettingsButton_Click">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
              </Button>
              <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{ThemeResource SubtleTextBrush}" />
                <TextBlock x:Name="SidebarStatusText" Grid.Column="1" Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center" Text="准备就绪" TextTrimming="CharacterEllipsis" MaxLines="2" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Padding="20,12,20,12" Spacing="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock x:Name="MainTitleText" Text="网络流量监控" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="MainSubtitleText" Style="{StaticResource CaptionStyle}"
                           Text="记录电脑实际发送与接收的流量" />
              </StackPanel>
              <Border Grid.Column="1" Padding="10,4" CornerRadius="12"
                      Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{ThemeResource SubtleTextBrush}" />
                  <TextBlock x:Name="StatusText" Text="未运行" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="5">
                  <TextBlock x:Name="CurrentDownloadLabel" Style="{StaticResource CaptionStyle}" Text="当前下载" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" Foreground="{StaticResource DownloadBrush}" FontSize="18" />
                    <TextBlock x:Name="CurrentDownloadText" Text="0.000" FontSize="22" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock x:Name="DownloadUnitText" Text="MB/s" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="5">
                  <TextBlock x:Name="CurrentUploadLabel" Style="{StaticResource CaptionStyle}" Text="当前上传" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE898;" Foreground="{StaticResource UploadBrush}" FontSize="18" />
                    <TextBlock x:Name="CurrentUploadText" Text="0.000" FontSize="22" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock x:Name="UploadUnitText" Text="MB/s" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="5">
                  <TextBlock x:Name="ElapsedLabel" Style="{StaticResource CaptionStyle}" Text="已运行" />
                  <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock x:Name="RemainingText" Text="尚未开始" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="14,10,14,8">
              <StackPanel Spacing="6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock x:Name="ChartTitleText" Style="{StaticResource SectionTitleStyle}" Text="实时速度趋势" />
                    <TextBlock x:Name="ChartSubtitleText" Style="{StaticResource CaptionStyle}"
                               Text="最近 60 个采样点，纵轴会自动调整" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{StaticResource DownloadBrush}" />
                      <TextBlock x:Name="DownloadLegendText" Text="下载" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{StaticResource UploadBrush}" />
                      <TextBlock x:Name="UploadLegendText" Text="上传" FontSize="12" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <local:SpeedChart x:Name="Chart" Height="160" />
              </StackPanel>
            </Border>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="14,10,14,6" Spacing="2">
                    <TextBlock x:Name="RecentTitleText" Style="{StaticResource SectionTitleStyle}" Text="最近 5 条采样" />
                    <TextBlock x:Name="RecentSubtitleText" Style="{StaticResource CaptionStyle}" Text="新记录显示在最上方" />
                  </StackPanel>
                  <Grid Grid.Row="1" Padding="14,5" Background="{ThemeResource AppPaneBrush}" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72" />
                      <ColumnDefinition Width="105" />
                      <ColumnDefinition Width="105" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RecentTimeHeader" Text="时间" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="RecentDownloadHeader" Grid.Column="1" Text="下载 MB/s" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="RecentUploadHeader" Grid.Column="2" Text="上传 MB/s" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="RecentAdapterHeader" Grid.Column="3" Text="网卡" Style="{StaticResource CaptionStyle}" />
                  </Grid>
                  <ListView x:Name="RecentSamplesList" Grid.Row="2" MinHeight="140" MaxHeight="154"
                            SelectionMode="None" ItemsSource="{x:Bind RecentSamples}">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="14,5" />
                      </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="local:SampleRow">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{x:Bind Time}" />
                          <TextBlock Grid.Column="1" Text="{x:Bind Download}" />
                          <TextBlock Grid.Column="2" Text="{x:Bind Upload}" />
                          <TextBlock Grid.Column="3" Text="{x:Bind Adapters}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </Grid>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="SummaryTitleText" Style="{StaticResource SectionTitleStyle}" Text="本次统计" />
                    <TextBlock x:Name="SummaryStateText" Style="{StaticResource CaptionStyle}"
                               Text="开始记录后显示统计结果" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="SampleTrafficLabel" Style="{StaticResource CaptionStyle}" Text="样本与流量" />
                    <TextBlock x:Name="SampleCountText" Text="0 个样本" FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalTrafficText" Text="下载 0 MB · 上传 0 MB" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="MinimumLabel" Style="{StaticResource CaptionStyle}" Text="最小速度" />
                    <TextBlock x:Name="MinimumSpeedText" Text="下载 — · 上传 —" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="MaximumLabel" Style="{StaticResource CaptionStyle}" Text="最大速度" />
                    <TextBlock x:Name="MaximumSpeedText" Text="下载 — · 上传 —" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="AverageLabel" Style="{StaticResource CaptionStyle}" Text="平均速度" />
                    <TextBlock x:Name="AverageSpeedText" Text="下载 — · 上传 —" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Grid>
              <InfoBar x:Name="SessionInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"
                       Padding="0,0,174,0"
                       Message="设置参数后点击“开始记录”。CSV 会在每次采样后立即保存。" />
              <Button x:Name="OpenResultsButton" Content="打开结果文件夹" Visibility="Collapsed"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                      Click="OpenResultsButton_Click" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

  </Grid>
</Window>
