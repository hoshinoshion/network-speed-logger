<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="SettingsWindow"
        Title="设置"
        Width="650" Height="720" MinWidth="610" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#F3F6FA"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#4F7CFF"/>

    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E3E9F2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#25324A"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#5F6D82"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InputTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Background" Value="#F8FAFD"/>
      <Setter Property="Foreground" Value="#1F2B3D"/>
      <Setter Property="BorderBrush" Value="#CDD6E3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InputCombo" TargetType="ComboBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Background" Value="#F8FAFD"/>
      <Setter Property="Foreground" Value="#1F2B3D"/>
      <Setter Property="BorderBrush" Value="#CDD6E3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,4"/>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#4F7CFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#E9EEF6"/>
      <Setter Property="Foreground" Value="#43516A"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="White" BorderBrush="#E3E9F2" BorderThickness="0,0,0,1" Padding="24,20">
      <StackPanel>
        <TextBlock x:Name="SettingsHeadingText" Text="设置" Foreground="#172033" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock x:Name="SettingsSubtitleText" Text="管理应用行为和每次启动时载入的记录默认值" Foreground="#7D899C" FontSize="11" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22,18,22,10">
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock x:Name="GeneralSectionTitle" Text="通用" Style="{StaticResource SectionTitle}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="225"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="SettingsLanguageLabel" Text="界面语言" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="SettingsLanguageCombo" Grid.Column="1" Style="{StaticResource InputCombo}" SelectedIndex="0">
                <ComboBoxItem x:Name="SettingsAutoLanguageItem" Content="自动（跟随系统）" Tag="Auto"/>
                <ComboBoxItem x:Name="SettingsChineseLanguageItem" Content="简体中文" Tag="zh-CN"/>
                <ComboBoxItem x:Name="SettingsEnglishLanguageItem" Content="English" Tag="en-US"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock x:Name="DefaultsSectionTitle" Text="记录默认配置" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="DefaultDurationLabel" Text="默认记录时长（小时）" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="DefaultDurationHint" Text="输入 0 表示不限时" Foreground="#98A3B4" FontSize="10" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBox x:Name="DefaultDurationText" Grid.Column="1" Style="{StaticResource InputTextBox}" Text="24"/>
            </Grid>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="DefaultIntervalLabel" Text="默认采样间隔（秒）" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="DefaultIntervalText" Grid.Column="1" Style="{StaticResource InputTextBox}" Text="15"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="DefaultUnitLabel" Text="默认速度单位" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="DefaultUnitCombo" Grid.Column="1" Style="{StaticResource InputCombo}" SelectedIndex="0">
                <ComboBoxItem Content="MB/s" Tag="MB/s"/>
                <ComboBoxItem Content="Mbps" Tag="Mbps"/>
              </ComboBox>
            </Grid>
            <TextBlock x:Name="DefaultsExplanationText"
                       Text="应用每次启动时都会载入这些值；主窗口中的临时修改只在本次启动期间有效。"
                       Foreground="#7D899C" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock x:Name="FilesSectionTitle" Text="文件" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="SettingsOutputFolderLabel" Text="CSV 和 Markdown 保存文件夹" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="SettingsOutputFolderText" Style="{StaticResource InputTextBox}" IsReadOnly="True"/>
              <Button x:Name="SettingsBrowseButton" Grid.Column="2" Content="更改…" Style="{StaticResource SecondaryButton}" Padding="14,8"/>
              <Button x:Name="SettingsOpenFolderButton" Grid.Column="4" Content="打开" Style="{StaticResource SecondaryButton}" Padding="14,8"/>
            </Grid>
            <TextBlock x:Name="OutputFolderRunningHint" Text="记录过程中不能更改保存文件夹。" Foreground="#98A3B4" FontSize="10" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Margin="0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="AboutSectionTitle" Text="关于" Style="{StaticResource SectionTitle}" Margin="0,0,0,9"/>
              <TextBlock Text="Network Speed Logger" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock x:Name="VersionText" Text="版本 0.3.0" Foreground="#8793A5" FontSize="10" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="RepositoryButton" Grid.Column="1" Content="GitHub 仓库" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F2" BorderThickness="0,1,0,0" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="CancelSettingsButton" Content="取消" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinWidth="84"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="SaveSettingsButton" Content="保存" Style="{StaticResource SecondaryButton}" MinWidth="84" Margin="0,0,10,0"/>
          <Button x:Name="ApplyDefaultsButton" Content="立即应用默认配置" Style="{StaticResource BaseButton}" MinWidth="142"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
