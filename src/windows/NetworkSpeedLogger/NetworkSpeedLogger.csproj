<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <StartupObject>NetworkSpeedLogger.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <LangVersion>latest</LangVersion>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <AssemblyTitle>Network Speed Logger</AssemblyTitle>
    <Description>Bilingual Windows network speed logger / 双语 Windows 网速记录工具</Description>
    <Product>Network Speed Logger</Product>
    <Company>hoshinoshion</Company>
    <Copyright>Copyright © 2026 hoshinoshion</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="MainWindow.xaml" LogicalName="NetworkSpeedLogger.MainWindow.xaml" />
    <EmbeddedResource Include="SettingsWindow.xaml" LogicalName="NetworkSpeedLogger.SettingsWindow.xaml" />
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
